# Same syntax as .gitignore. A leading / anchors the pattern to this directory.

# Images
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.svg
*.ico
*.webp
*.tiff

# Video
*.mp4
*.avi
*.mov
*.mkv
*.wmv
*.flv
*.webm

# Audio
*.mp3
*.wav
*.flac
*.aac
*.ogg
*.m4a

# Binary/Compiled
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.obj
*.o

# Archives
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.bz2
*.gz

# Data files
*.db
*.sqlite
*.sqlite3
*.parquet
*.arrow

# Config formats
*.json
*.yaml
*.yml

# Vendored firmware trees, 9.7G between them.
/corne/
/keyball/
/keyball_qmk/
/qmk_firmware/
/zmk/

# Generated lockfiles.
Cargo.lock
composer.lock
flake.lock
Gemfile.lock
go.sum
package-lock.json
pnpm-lock.yaml
poetry.lock
uv.lock
yarn.lock

.git/
